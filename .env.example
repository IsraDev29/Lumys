JWT_SECRET=replace-with-a-long-random-secret
# Ojo: en una plataforma con datos de salud mental de menores, un token de 7d
# significa que una sesión robada sirve una semana entera. 12h obliga a
# reingresar una vez al día y es lo que se recomienda acá.
JWT_EXPIRES_IN=12h

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=replace-with-your-brevo-sender-email

PORT=5000
NODE_ENV=development

# Orígenes autorizados para CORS, separados por coma. El frontend servido por
# este mismo Express no los necesita: son para el desarrollo con Live Server y
# para un frontend desplegado aparte (React).
CORS_ORIGENES=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5500

# Número de proxies en los que se confía para leer X-Forwarded-For. Vacío = no
# se confía en ninguno. Poner 1 detrás de Render, Railway o nginx: sin esto todo
# el tráfico comparte cupo de rate limit, porque req.ip sería la del proxy.
# TRUST_PROXY=1

# --- Módulo de IA ----------------------------------------------------------
# auto      : Ollama primero para los turnos (manda la latencia), Anthropic
#             primero para el análisis (manda la calidad), con degradación
#             cruzada. Es el valor útil.
# ollama    : fuerza solo el modelo local.
# anthropic : fuerza solo el remoto.
# ninguno   : desactiva la IA; todo usa el banco local de preguntas.
IA_PROVEEDOR=auto

# Modelo remoto.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
IA_MODELO=claude-opus-4-8

# Modelo local. gemma3:1b es el único realista sin GPU; gemma3:4b escribe
# mejores preguntas pero en CPU la espera se vuelve incómoda.
#   ollama pull gemma3:1b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=gemma3:1b

# Cuánto se queda el modelo cargado en RAM tras la última petición. Sin esto
# Ollama lo descarga a los 5 minutos y el siguiente estudiante paga la recarga.
OLLAMA_KEEP_ALIVE=30m

# Presupuesto de latencia. Pasado el plazo se corta y el check-in sigue con el
# banco local: una pregunta menos ingeniosa es mejor que una pantalla congelada.
OLLAMA_TIMEOUT_MS=8000
OLLAMA_TIMEOUT_ANALISIS_MS=25000

# Contexto del modelo local. Más grande no mejora la respuesta y sí cuesta RAM y
# tiempo de arranque; el prompt compacto entra de sobra en 2048.
OLLAMA_NUM_CTX=2048

# IA_TRAZA=1 registra latencia y tokens/s de cada llamada local. Es la forma de
# medir si el modelo elegido sirve en la máquina donde corre.
# IA_TRAZA=1
