{
  "name": "lumys",
  "version": "1.0.0",
  "description": "Plataforma Web inteligente y comunitaria para la gestion de la salud mental, de Nicaragua.",
  "main": "src/server.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "concurrently -n api,vite -c green,magenta \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "nodemon src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node src/server.js",
    "postinstall": "npm --prefix client install",
    "tipos": "npm --prefix client run tipos",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:unit": "node --test test/ia.seguridad.test.js test/icve.test.js test/ia.proveedores.test.js test/ia.contexto.test.js",
    "test:privacidad": "node --test test/privacidad.roles.test.js test/http.seguridad.test.js",
    "test:lumy": "node --test test/lumy.test.js",
    "test:seguridad": "node --test test/http.seguridad.test.js",
    "lumy:svg": "node tools/lumy-exportar-svg.js",
    "doctor": "npx react-doctor@latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "react-doctor": "^0.9.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  }
}
